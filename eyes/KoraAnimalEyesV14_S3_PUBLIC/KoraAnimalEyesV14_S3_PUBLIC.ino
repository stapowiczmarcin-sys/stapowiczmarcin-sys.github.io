namespace Kora3D {
static constexpr int SIZE=240;
static constexpr float IRIS_X=119.5f;
static constexpr float IRIS_Y=119.5f;
static constexpr float IRIS_RADIUS=78.f;
static constexpr float GLOBE_RADIUS=145.f;
struct Surface { uint16_t white; };
static float limit(float v,float lo,float hi){return v<lo?lo:(v>hi?hi:v);}
static uint16_t color(int r,int g,int b){return (int(limit(r,0,255))>>3)<<11|(int(limit(g,0,255))>>2)<<5|(int(limit(b,0,255))>>3);}
static uint16_t blend(uint16_t a,uint16_t b,int w) {
  w=w<0?0:(w>256?256:w);
  // Five fractional bits fit the gap between R and B in this packed layout.
  // Using eight here would leak the red fractional bits into the blue channel.
  w=(w+4)>>3;
  uint32_t rb=((a&0xf81f)*(32-w)+(b&0xf81f)*w)>>5;
  uint32_t g=((a&0x07e0)*(32-w)+(b&0x07e0)*w)>>5;
  return (rb&0xf81f)|(g&0x07e0);
}
static uint16_t mix(uint16_t a,uint16_t b,float w){return blend(a,b,int(limit(w,0,1)*256));}
static uint16_t dim(uint16_t a,float w){return blend(0,a,int(limit(w,0,1)*256));}
static uint16_t sampleY(const uint16_t* tex,int x,float y) {
  y=limit(y,0,238.999f);int iy=int(y);
  return blend(tex[iy*SIZE+x],tex[(iy+1)*SIZE+x],int((y-iy)*256));
}
static uint16_t sample(const uint16_t* tex,float x,float y) {
  x=limit(x,0,238.999f);int ix=int(x);
  return blend(sampleY(tex,ix,y),sampleY(tex,ix+1,y),int((x-ix)*256));
}
struct Landmark {float x,upper,lower,seam;};
static const Landmark landmarks[]={
 {0,106,106,117},{12,95,125,127},{24,86,142,133},
 {40,79,158,136},{60,75,168,139},{80,74,174,140},
 {100,77,177,141},{120,82,178,142},{140,88,177,144},
 {160,97,173,148},{180,111,168,151},{196,128,163,154},
 {210,147,158,157},{220,161,161,160},{239,164,164,164}
};
static void contours(float x,float& up,float& low,float& seam) {
 int i=0;while(i<13&&x>landmarks[i+1].x)i++;
 const Landmark& a=landmarks[i];const Landmark& b=landmarks[i+1];
 float t=limit((x-a.x)/(b.x-a.x),0,1);
 up=a.upper+(b.upper-a.upper)*t;low=a.lower+(b.lower-a.lower)*t;
 seam=a.seam+(b.seam-a.seam)*t;
}
// Optional makeup recolors only pink fur/lid pixels, preserving luminance.
static int lidMode=0;
static bool centeredGaze=true;
static uint16_t lidTint(uint16_t p) {
 if(!lidMode)return p;
 int r=((p>>11)&31)*255/31,g=((p>>5)&63)*255/63,b=(p&31)*255/31;
 float mask=limit((r-g-12)/65.f,0,1)*.40f;
 int lum=(r+g+b)/3;
 uint16_t t=lidMode==1?color(lum+40,lum-16,lum+5):
   lidMode==2?color(lum+12,lum-15,lum+48):color(lum-25,lum+22,lum+28);
 return mix(p,t,mask);
}
static void geometry(Surface* lut) {
  // A complete photographic sclera plate avoids any residual iris silhouette.
  for(int y=0;y<SIZE;y++)for(int x=0;x<SIZE;x++) {
    float up,lo,seam;contours(x,up,lo,seam);
    float yy=lo-up>8?limit(y,up+3,lo-3):float(y);
    lut[y*SIZE+x].white=sampleY(kPhotoSclera,x,yy);
  }
}
struct Column {float uo,lo,seam,up,low,topO,topC,bottomO,bottomC;};
static Column columns[SIZE]; // Scratch: main rendering task only, not the stack.
static void render(uint16_t* dst,const Surface* lut,const uint8_t*,
                   float open,float tilt,float curve,float gazeX,float gazeY,
                   float pupil,uint16_t,bool left,float breath) {
  float a=limit((open-.03f)/.85f,0,1.07f);
  if(a>.97f&&a<1.03f)a=1;
  int photoWeight=int(limit(a,0,1)*256);
  float yaw=limit(left?gazeX:-gazeX,-1,1)*.22f;
  float pitch=limit(gazeY,-1,1)*.14f;
  float cy=cosf(yaw),sy=sinf(yaw),cp=cosf(pitch),sp=sinf(pitch);
  float pr=3.f+limit(pupil,0,1)*30.f;
  for(int x=0;x<SIZE;x++) {
    Column& c=columns[x];contours(x,c.uo,c.lo,c.seam);
    float aperture=limit((c.lo-c.uo)/25.f,0,1);
    float slope=(tilt-.12f)*(x-IRIS_X)*.09f*a*aperture;
    c.up=c.seam+(c.uo-c.seam)*a*(1-curve*.10f)+slope+breath;
    c.low=c.seam+(c.lo-c.seam)*a*(1-curve*.32f)+breath;
    if(c.up>c.low)c.up=c.low;
    c.topO=c.uo/(c.up+.001f);c.topC=c.seam/(c.up+.001f);
    c.bottomO=(239-c.lo)/(239-c.low+.001f);c.bottomC=(239-c.seam)/(239-c.low+.001f);
  }
  for(int y=0;y<SIZE;y++)for(int outX=0;outX<SIZE;outX++) {
    int idx=y*SIZE+outX;float rx=outX-119.5f,ry=y-119.5f;
    if(rx*rx+ry*ry>119.7f*119.7f){dst[idx]=0;continue;}
    int x=left?outX:239-outX;
    const Column& c=columns[x];
    if(a==0&&breath==0){dst[idx]=lidTint(kPhotoClosed[y*SIZE+x]);continue;}
    float top=y-c.up,bottom=c.low-y;
    if(top<.5f||bottom<.5f||x<5||x>234||a==0) {
      float yo,yc;
      if(top<0){yo=y*c.topO;yc=y*c.topC;}
      else {yo=c.lo+(y-c.low)*c.bottomO;yc=c.seam+(y-c.low)*c.bottomC;}
      if(photoWeight==256)dst[idx]=sampleY(kPhotoSclera,x,yo);
      else if(photoWeight==0)dst[idx]=sampleY(kPhotoClosed,x,yc);
      else dst[idx]=blend(sampleY(kPhotoClosed,x,yc),sampleY(kPhotoSclera,x,yo),photoWeight);
      dst[idx]=lidTint(dst[idx]);
      continue;
    }
    uint16_t eye=lut[y*SIZE+x].white;
    // Orthographic projection of a sphere rotates the iris, rather than sliding a disk.
    float nx=(x-IRIS_X)/GLOBE_RADIUS,ny=(y-IRIS_Y)/GLOBE_RADIUS;
    float nz=sqrtf(limit(1-nx*nx-ny*ny,0,1));
    float u=(nx*cy-nz*sy)*GLOBE_RADIUS;
    float v=(-nx*sy*sp+ny*cp-nz*cy*sp)*GLOBE_RADIUS;
    float r=sqrtf(u*u+v*v);
    if(r<IRIS_RADIUS+1) {
      // Elliptical slit dilates horizontally. Fibres stretch around its boundary.
      float pupilH=61.f+limit(pupil,0,1)*7.f;
      float invR=1.f/(r+.0001f);
      float ca=u*invR,sa=v*invR;
      float boundary=1.f/sqrtf(ca*ca/(pr*pr)+sa*sa/(pupilH*pupilH)+.000001f);
      float sr=limit((r-boundary)/(IRIS_RADIUS-boundary),0,1)*99.f;
      uint16_t iris=sample(kPhotoIris,120.f+ca*sr,112.f+sa*sr);
      iris=mix(color(2,3,3),iris,limit(r-boundary+.5f,0,1));
      iris=dim(iris,1-.45f*limit((r-IRIS_RADIUS+5)/5,0,1));
      eye=mix(eye,iris,limit((IRIS_RADIUS+1-r)/1.7f,0,1));
      // Corneal reflections stay on the same lit side in both eyes.
      float gx=left?IRIS_X+sy*GLOBE_RADIUS:239-IRIS_X-sy*GLOBE_RADIUS;
      float gy=IRIS_Y+sp*GLOBE_RADIUS;
      float hx=(outX-(gx-22))/12.f,hy=(y-(gy-25))/7.f;
      float shine=limit((1-hx*hx-hy*hy)*2,0,1)*.85f;
      eye=mix(eye,color(245,248,242),shine);
      hx=(outX-(gx+19))/3.f;hy=(y-(gy+17))/2.f;
      eye=mix(eye,color(220,229,229),limit(1-hx*hx-hy*hy,0,1)*.65f);
    }
    // The photographic lash roots/waterline sit over the moving globe at its edges.
    float rim=limit(1-fminf(top,bottom)/2.2f,0,1);
    if(rim>0) {
      float yo,yc;
      if(top<bottom){yo=y*c.topO;yc=y*c.topC;}
      else {yo=c.lo+(y-c.low)*c.bottomO;yc=c.seam+(y-c.low)*c.bottomC;}
      uint16_t skin=blend(sampleY(kPhotoClosed,x,yc),sampleY(kPhotoSclera,x,yo),photoWeight);
      eye=mix(eye,lidTint(skin),rim);
    }
    float shade=1-.32f*(1-limit(a,0,1))*limit(1-top/8,0,1);
    dst[idx]=dim(eye,shade);
  }
}
