class PsramCanvas16 : public GFXcanvas16 {
public:
  PsramCanvas16(uint16_t w, uint16_t h) : GFXcanvas16(w, h, false) {
    const size_t bytes = (size_t)w * (size_t)h * sizeof(uint16_t);
    buffer = (uint16_t *)heap_caps_malloc(bytes, MALLOC_CAP_SPIRAM | MALLOC_CAP_8BIT);
    if (buffer) memset(buffer, 0, bytes);
  }

  ~PsramCanvas16() {
    if (buffer) {
      heap_caps_free(buffer);
      buffer = nullptr;
    }
  }
};

