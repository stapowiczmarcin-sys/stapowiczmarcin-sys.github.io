// Photographic lids/lashes, anatomical contours and a spherical iris projection.
// Source assets are embedded above. The same renderer generates the preview.
namespace KoraPower {
enum Phase {Awake,Closing,Hold,FadeOut,Off,WakeWait,FadeIn,Opening};
struct State {
 Phase phase=Off; bool sleeping=true; uint32_t at=0;
 float light=0,lid=0,fromLight=0,fromLid=0;
 static float smooth(float t){if(t<0)t=0;if(t>1)t=1;return t*t*(3-2*t);}
 void begin(Phase p,uint32_t now){phase=p;at=now;fromLight=light;fromLid=lid;}
 void request(bool sleep,uint32_t now){
  if(sleep==sleeping)return;
  sleeping=sleep;begin(sleep?Closing:WakeWait,now);
 }
 void tick(uint32_t now){
  for(int n=0;n<8;n++){
   uint32_t elapsed=now-at,duration=0;Phase next=phase;
   switch(phase){
    case Closing:duration=350;lid=fromLid*(1-smooth(elapsed/350.f));next=Hold;break;
    case Hold:duration=5000;lid=0;next=FadeOut;break;
    case FadeOut:duration=1200;light=fromLight*(1-smooth(elapsed/1200.f));next=Off;break;
    case WakeWait:duration=150;next=FadeIn;break;
    case FadeIn:duration=900;light=fromLight+(1-fromLight)*smooth(elapsed/900.f);next=Opening;break;
    case Opening:duration=350;lid=fromLid+(1-fromLid)*smooth(elapsed/350.f);next=Awake;break;
    case Off:light=0;lid=0;return;
    case Awake:light=1;lid=1;return;
   }
   if(elapsed<duration)return;
   begin(next,at+duration);
  }
 }
};
static void dim(uint16_t* pixels,int count,float light){
 if(light>=.9999f)return;
 unsigned k=unsigned(light*256.f);if(k>256)k=256;
 for(int i=0;i<count;i++){unsigned c=pixels[i];pixels[i]=((((c>>11)*k)>>8)<<11)|(((((c>>5)&63)*k)>>8)<<5)|(((c&31)*k)>>8);}
}
}

