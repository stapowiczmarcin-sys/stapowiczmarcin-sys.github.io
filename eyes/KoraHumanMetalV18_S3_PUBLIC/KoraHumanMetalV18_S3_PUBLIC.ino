  for(;;) {
    KoraMouth::Input in;
    portENTER_CRITICAL(&mouthMux);in=mouthInput;portEXIT_CRITICAL(&mouthMux);
    motion.tick(in,millis());
    int left=lroundf(MOUTH_L_CLOSED+(MOUTH_L_OPEN-MOUTH_L_CLOSED)*motion.left);
    int right=lroundf(MOUTH_R_CLOSED+(MOUTH_R_OPEN-MOUTH_R_CLOSED)*motion.right);
    mouthL.write(constrain(left,MOUTH_MIN_ANGLE,MOUTH_MAX_ANGLE));
    mouthR.write(constrain(right,MOUTH_MIN_ANGLE,MOUTH_MAX_ANGLE));
    portENTER_CRITICAL(&mouthMux);
    mouthOpenL=motion.left;mouthOpenR=motion.right;
    portEXIT_CRITICAL(&mouthMux);
    vTaskDelayUntil(&tick,pdMS_TO_TICKS(20));
  }
