namespace KoraPupil {
enum Mode { ANIMATED, AUTO, MANUAL };
static const char* modeNames[]={"ANIMATED","AUTO","MANUAL"};
static constexpr float MIN_SIZE=.12f,MAX_SIZE=.82f;
static float clamp(float x,float a,float b){return x<a?a:(x>b?b:x);}
static float sizeFromPercent(float p){return MIN_SIZE+(MAX_SIZE-MIN_SIZE)*clamp(p,0,100)*.01f;}
static float percentFromSize(float p){return clamp((p-MIN_SIZE)*100/(MAX_SIZE-MIN_SIZE),0,100);}
static float normalize(int adc,int dark,int bright){return clamp(100.f*(adc-dark)/(bright-dark),0,100);}
struct Controller {
  Mode mode=ANIMATED;
  float value=.5f,target=.5f,filtered=50,accepted=50;
  bool hasLight=false,filterReady=false,started=false;
  uint32_t at=0;
  void animated(float left,float right){if(mode==ANIMATED)value=target=(left+right)*.5f;}
  void manual(){mode=MANUAL;target=value;}
  void setPercent(float p){mode=MANUAL;target=sizeFromPercent(p);}
  void automatic(){mode=AUTO;target=value;filterReady=false;}
  void tick(uint32_t now,bool fresh,float ambient){
    float dt=started?clamp(float(uint32_t(now-at))*.001f,0,.1f):0;
    at=now;started=true;hasLight=fresh;
    if(fresh){
      ambient=clamp(ambient,0,100);
      if(!filterReady){filtered=accepted=ambient;filterReady=true;}
      else filtered+=(ambient-filtered)*(dt/(.35f+dt));
      if(fabsf(filtered-accepted)>=2.f)accepted=filtered;
    }
    if(mode==ANIMATED)return;
    if(mode==AUTO){
      if(!fresh){target=value;return;}
      target=sizeFromPercent(100-accepted);
    }
    // Faster constriction than dilation, independent of frame rate.
    float tau=target<value?.35f:1.10f;
    value+=(target-value)*(dt/(tau+dt));
  }
};
static Controller control;
