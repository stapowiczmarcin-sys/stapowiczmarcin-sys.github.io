static void mouthTask(void*) {
  KoraMouth::Motion motion;motion.rng=esp_random();motion.at=millis();
  KoraServo::Axis leftEar,rightEar;uint32_t at=millis();
  TickType_t tick=xTaskGetTickCount();
  for(;;) {
    KoraMouth::Input in;float el,er;
    portENTER_CRITICAL(&mouthMux);in=mouthInput;el=earCommandL;er=earCommandR;portEXIT_CRITICAL(&mouthMux);
    uint32_t now=millis();float dt=KoraServo::clamp((now-at)*.001f,0,.05f);at=now;
    motion.tick(in,now);
    float left=KoraServo::clamp(MOUTH_L_CLOSED+(MOUTH_L_OPEN-MOUTH_L_CLOSED)*motion.left,MOUTH_MIN_ANGLE,MOUTH_MAX_ANGLE);
    float right=KoraServo::clamp(MOUTH_R_CLOSED+(MOUTH_R_OPEN-MOUTH_R_CLOSED)*motion.right,MOUTH_MIN_ANGLE,MOUTH_MAX_ANGLE);
    mouthL.writeMicroseconds(servoPulse(left,MOUTH_MIN_US,MOUTH_MAX_US));
    mouthR.writeMicroseconds(servoPulse(right,MOUTH_MIN_US,MOUTH_MAX_US));
    leftEar.tick(el,dt,9,70,240,-35,35);rightEar.tick(er,dt,9,70,240,-35,35);
    float la=KoraServo::clamp(EAR_CENTER_L+(EAR_L_REVERSED?-leftEar.position:leftEar.position),EAR_MIN_L,EAR_MAX_L);
    float ra=KoraServo::clamp(EAR_CENTER_R+(EAR_R_REVERSED?-rightEar.position:rightEar.position),EAR_MIN_R,EAR_MAX_R);
    earL.writeMicroseconds(servoPulse(la,500,2400));earR.writeMicroseconds(servoPulse(ra,500,2400));
    portENTER_CRITICAL(&mouthMux);
    mouthOpenL=motion.left;mouthOpenR=motion.right;
    earOutputL=leftEar.position;earOutputR=rightEar.position;
    portEXIT_CRITICAL(&mouthMux);
    vTaskDelayUntil(&tick,pdMS_TO_TICKS(20));
  }
}
static void setupMouth() {
  mouthL.setPeriodHertz(50);mouthR.setPeriodHertz(50);
  mouthL.attach(PIN_MOUTH_L,MOUTH_MIN_US,MOUTH_MAX_US);
  mouthR.attach(PIN_MOUTH_R,MOUTH_MIN_US,MOUTH_MAX_US);
  mouthL.write(MOUTH_L_CLOSED);mouthR.write(MOUTH_R_CLOSED);
  if(!mouthL.attached()||!mouthR.attached()) {Serial.println("ERR MOUTH SERVO ATTACH");return;}
  if(xTaskCreatePinnedToCore(mouthTask,"servos",4096,nullptr,1,&mouthTaskHandle,0)!=pdPASS) {
    mouthTaskHandle=nullptr;Serial.println("ERR MOUTH TASK");return;
  }
  Serial.println("SERVOS READY: ears 15/16 + mouth 17/18; smooth 20ms updates");
}
static bool parsePercent(String s,int& value) {
  s.trim();if(!s.length())return false;
  char* end=nullptr;long parsed=strtol(s.c_str(),&end,10);
  if(*end||parsed<0||parsed>100)return false;
  value=int(parsed);return true;
}
// Disabled until the actual sensor GPIOs and divider calibration are supplied.
static constexpr int PIN_LIGHT_L=-1, PIN_LIGHT_R=-1;
static constexpr int LIGHT_DARK_L=0,LIGHT_BRIGHT_L=4095;
static constexpr int LIGHT_DARK_R=0,LIGHT_BRIGHT_R=4095;
static bool lightLocalReady=false,lightRemoteSeen=false,lightLocalSeen=false;
static float lightLocal=50,lightRemote=50;
static uint32_t lightRemoteAt=0,lightSampleAt=0;
static const char* lightSource="none";
static bool lightPinValid(int p){
  // ADC1 only: Wi-Fi remains usable. Reject every already-assigned pin.
  const int occupied[]={PIN_SCK,PIN_MOSI,PIN_CS_L,PIN_DC_L,PIN_RST_L,PIN_CS_R,PIN_DC_R,PIN_RST_R,PIN_EAR_L,PIN_EAR_R,PIN_MOUTH_L,PIN_MOUTH_R,PIN_FSR_L,PIN_FSR_R};
  if(p<1||p>10)return false;
  for(int used:occupied)if(p==used)return false;
  return true;
}
static void setupLightSensors(){
  if(PIN_LIGHT_L==-1&&PIN_LIGHT_R==-1)return;
  lightLocalReady=lightPinValid(PIN_LIGHT_L)&&lightPinValid(PIN_LIGHT_R)&&PIN_LIGHT_L!=PIN_LIGHT_R&&LIGHT_DARK_L!=LIGHT_BRIGHT_L&&LIGHT_DARK_R!=LIGHT_BRIGHT_R;
  if(!lightLocalReady){Serial.println("ERR LIGHT configuration; ADC disabled");return;}
  pinMode(PIN_LIGHT_L,INPUT);pinMode(PIN_LIGHT_R,INPUT);
  analogSetPinAttenuation(PIN_LIGHT_L,ADC_11db);analogSetPinAttenuation(PIN_LIGHT_R,ADC_11db);
}
static void updateLightPupil(){
  uint32_t now=millis();
  if(lightLocalReady&&(!lightLocalSeen||uint32_t(now-lightSampleAt)>=50)){
    lightSampleAt=now;lightLocalSeen=true;
    float l=KoraPupil::normalize(analogRead(PIN_LIGHT_L),LIGHT_DARK_L,LIGHT_BRIGHT_L);
    float r=KoraPupil::normalize(analogRead(PIN_LIGHT_R),LIGHT_DARK_R,LIGHT_BRIGHT_R);
    lightLocal=(l+r)*.5f;
  }
  bool remoteFresh=lightRemoteSeen&&uint32_t(now-lightRemoteAt)<=2000;
  bool fresh=remoteFresh||lightLocalSeen;
  lightSource=remoteFresh?"serial":(lightLocalSeen?"adc_mean":(lightRemoteSeen?"serial_stale":"none"));
  KoraPupil::control.tick(now,fresh,remoteFresh?lightRemote:lightLocal);
}
static bool handleIrisPupil(const String& upper){
  if(upper.startsWith("IRIS ")){
    String arg=upper.substring(5);arg.trim();
    for(int i=0;i<7;i++)if(arg==KoraIris::names[i]){KoraIris::select(KoraIris::Colour(i));Serial.println("OK IRIS "+arg);return true;}
    Serial.println("ERR IRIS ORIGINAL|BLUE|GREEN|GREY|HAZEL|RED|PURPLE");return true;
  }
  if(upper.startsWith("PUPIL ")){
    String arg=upper.substring(6);arg.trim();int value;
    if(arg=="AUTO")KoraPupil::control.automatic();
    else if(arg=="MANUAL")KoraPupil::control.manual();
    else if(arg=="ANIMATED")KoraPupil::control.mode=KoraPupil::ANIMATED;
    else if(parsePercent(arg,value))KoraPupil::control.setPercent(value);
    else {Serial.println("ERR PUPIL AUTO|MANUAL|ANIMATED|0..100");return true;}
    Serial.println("OK PUPIL "+arg);return true;
  }
  if(upper.startsWith("LIGHT ")){
    int value;if(!parsePercent(upper.substring(6),value)){Serial.println("ERR LIGHT 0..100");return true;}
    lightRemote=value;lightRemoteAt=millis();lightRemoteSeen=true;Serial.println("OK LIGHT");return true;
  }
  return false;
}

