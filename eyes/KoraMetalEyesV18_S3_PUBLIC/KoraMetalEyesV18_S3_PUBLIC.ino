namespace KoraPupil {
enum Mode { ANIMATED, AUTO, MANUAL };
static const char* modeNames[]={"ANIMATED","AUTO","MANUAL"};
static constexpr float MIN_SIZE=.12f,MAX_SIZE=.82f;
static float clamp(float x,float a,float b){return x<a?a:(x>b?b:x);}
static float sizeFromPercent(float p){return MIN_SIZE+(MAX_SIZE-MIN_SIZE)*clamp(p,0,100)*.01f;}
static float percentFromSize(float p){return clamp((p-MIN_SIZE)*100/(MAX_SIZE-MIN_SIZE),0,100);}
static float normalize(int adc,int dark,int bright){return clamp(100.f*(adc-dark)/(bright-dark),0,100);}
struct Controller {
  Mode mode=ANIMATED;
  float value=.5f,target=.5f,filtered=50,accepted=50;
  bool hasLight=false,filterReady=false,started=false;
  uint32_t at=0;
  void animated(float left,float right){if(mode==ANIMATED)value=target=(left+right)*.5f;}
  void manual(){mode=MANUAL;target=value;}
  void setPercent(float p){mode=MANUAL;target=sizeFromPercent(p);}
  void automatic(){mode=AUTO;target=value;filterReady=false;}
  void tick(uint32_t now,bool fresh,float ambient){
    float dt=started?clamp(float(uint32_t(now-at))*.001f,0,.1f):0;
    at=now;started=true;hasLight=fresh;
    if(fresh){
      ambient=clamp(ambient,0,100);
      if(!filterReady){filtered=accepted=ambient;filterReady=true;}
      else filtered+=(ambient-filtered)*(dt/(.35f+dt));
      if(fabsf(filtered-accepted)>=2.f)accepted=filtered;
    }
    if(mode==ANIMATED)return;
    if(mode==AUTO){
      if(!fresh){target=value;return;}
      target=sizeFromPercent(100-accepted);
    }
    // Faster constriction than dilation, independent of frame rate.
    float tau=target<value?.35f:1.10f;
    value+=(target-value)*(dt/(tau+dt));
  }
};
static Controller control;
}

namespace KoraCRT {
// In-place contraction, processed from the center outward so source pixels
// are never overwritten before being sampled. No second framebuffer needed.
static void compress(uint16_t* p,float sx,float sy){
 if(sx<=0||sy<=0){for(int i=0;i<57600;i++)p[i]=0;return;}
 if(sy<.99999f){
  for(int half=0;half<2;half++)for(int step=0;step<120;step++){
   int y=half?120+step:119-step;
   int source=int(floorf(119.5f+(y-119.5f)/sy+.5f));
   for(int x=0;x<240;x++)p[y*240+x]=(source>=0&&source<240)?p[source*240+x]:0;
  }
 }
 if(sx<.99999f)for(int y=0;y<240;y++){
  for(int half=0;half<2;half++)for(int step=0;step<120;step++){
   int x=half?120+step:119-step;
   int source=int(floorf(119.5f+(x-119.5f)/sx+.5f));
   p[y*240+x]=(source>=0&&source<240)?p[y*240+source]:0;
  }
 }
}
static void apply(uint16_t* p,const KoraPower::State& s){
 compress(p,s.sx,s.sy);
 float beam=s.phase==KoraPower::Collapse?KoraPower::State::smooth((.14f-s.sy)/.128f):
  ((s.phase==KoraPower::Line||s.phase==KoraPower::Dot)?1.f:0.f);
 if(beam<=0)return;
 float halfW=119.f*s.sx;
 for(int y=113;y<=126;y++){
  float dy=y-119.5f,glow=expf(-dy*dy/2.f)*.90f+expf(-dy*dy/13.f)*.2f;
  for(int x=0;x<240;x++){
   float edge=Kora3D::limit((halfW+4-fabsf(x-119.5f))/4,0,1);
   p[y*240+x]=Kora3D::mix(p[y*240+x],Kora3D::color(255,235,248),beam*glow*edge);
  }
 }
}
}



namespace KoraServo {
static float clamp(float v,float lo,float hi){return v<lo?lo:(v>hi?hi:v);}
struct Axis {
 float position=0,velocity=0;
 void tick(float target,float dt,float omega,float speed,float accel,float lo,float hi){
  target=clamp(target,lo,hi);dt=clamp(dt,0,.05f);
  // Small integration steps keep damping stable even after scheduling delays.
  int count=int(dt/.005f)+1;float h=dt/count;
  for(int i=0;i<count;i++){
   float a=clamp(omega*omega*(target-position)-2*omega*velocity,-accel,accel);
   float next=clamp(velocity+a*h,-speed,speed);
   position+=(velocity+next)*.5f*h;velocity=next;
   if(position<lo){position=lo;velocity=0;}if(position>hi){position=hi;velocity=0;}
  }
  if(fabsf(target-position)<.0001f&&fabsf(velocity)<.001f){position=target;velocity=0;}
 }
};
}

// Motion is independent of the renderer and independent of the main loop rate.
namespace KoraMouth {
static float bound(float v,float lo,float hi){return v<lo?lo:(v>hi?hi:v);}
struct Input {
  bool talk=false,external=false,manual=false;
  uint8_t level=0,manualLevel=0;
  uint32_t levelAt=0,manualAt=0;
};
struct Motion {
  KoraServo::Axis leftAxis,rightAxis;
  float left=0,right=0,syllable=0;
  uint32_t at=0,syllableAt=0,syllableMs=160,rng=0x4b4f5241;
  bool speaking=false;
  uint32_t randomWord(){rng^=rng<<13;rng^=rng>>17;rng^=rng<<5;return rng;}
  void tick(const Input& in,uint32_t now) {
    float dt=bound((now-at)*.001f,0,.05f);at=now;
    float target=0,asym=0;
    if(in.manual&&now-in.manualAt<800)target=in.manualLevel/100.f;
    else if(in.talk) {
      if(in.external) {
        // Once audio frames are used, missing frames close the jaw, never babble.
        target=now-in.levelAt<250?bound(in.level/100.f*1.20f,0,1):0;
      } else {
        if(!speaking||now-syllableAt>=syllableMs) {
          syllableAt=now;syllableMs=145+randomWord()%145;
          syllable=(randomWord()%7==0)?0:.35f+(randomWord()%66)/100.f;
        }
        float phase=bound(float(now-syllableAt)/syllableMs,0,1);
        float wave=sinf(phase*3.14159265f);wave*=wave;
        target=syllable*wave;
      }
      asym=target*.035f*sinf(now*.008f);
    }
    speaking=in.talk;
    float tl=bound(target+asym,0,1),tr=bound(target-asym,0,1);
    leftAxis.tick(tl,dt,30,5,40,0,1);rightAxis.tick(tr,dt,30,5,40,0,1);
    left=leftAxis.position;right=rightAxis.position;
    left=bound(left,0,1);right=bound(right,0,1);
  }
};
} // namespace KoraMouth



