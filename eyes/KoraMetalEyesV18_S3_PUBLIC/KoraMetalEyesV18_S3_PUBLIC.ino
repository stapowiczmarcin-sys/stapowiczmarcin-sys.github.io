// Photographic lids/lashes, anatomical contours and a spherical iris projection.
// Source assets are embedded above. The same renderer generates the preview.
namespace KoraPower {
enum Phase {Awake,Collapse,Line,Dot,Off,WakeWait,FadeIn,Opening};
struct State {
 Phase phase=Off;bool sleeping=true;uint32_t at=0;
 float light=0,lid=0,sx=0,sy=0,fromLight=0,fromLid=0,fromX=0,fromY=0;
 static float smooth(float t){t=t<0?0:(t>1?1:t);return t*t*(3-2*t);}
 void begin(Phase p,uint32_t now){phase=p;at=now;fromLight=light;fromLid=lid;fromX=sx;fromY=sy;}
 void request(bool sleep,uint32_t now){if(sleep==sleeping)return;sleeping=sleep;begin(sleep?Collapse:WakeWait,now);}
 void tick(uint32_t now){
  for(int n=0;n<8;n++){
   uint32_t elapsed=now-at,duration=0;Phase next=phase;
   switch(phase){
    case Collapse:duration=500;sy=fromY+(.012f-fromY)*smooth(elapsed/500.f);next=Line;break;
    case Line:duration=300;sx=fromX+(.012f-fromX)*smooth(elapsed/300.f);next=Dot;break;
    case Dot:duration=450;light=fromLight*(1-smooth(elapsed/450.f));next=Off;break;
    case WakeWait:duration=150;next=FadeIn;break;
    case FadeIn:{duration=700;float t=smooth(elapsed/700.f);light=fromLight+(1-fromLight)*t;sx=fromX+(1-fromX)*t;sy=fromY+(1-fromY)*t;next=Opening;break;}
    case Opening:duration=350;lid=fromLid+(1-fromLid)*smooth(elapsed/350.f);next=Awake;break;
    case Off:light=lid=sx=sy=0;return;
    case Awake:light=lid=sx=sy=1;return;
   }
   if(elapsed<duration)return;begin(next,at+duration);
  }
 }
};
static void dim(uint16_t* pixels,int count,float light){
 if(light>=.9999f)return;unsigned k=unsigned(light*256.f);if(k>256)k=256;
 for(int i=0;i<count;i++){unsigned c=pixels[i];pixels[i]=((((c>>11)*k)>>8)<<11)|(((((c>>5)&63)*k)>>8)<<5)|(((c&31)*k)>>8);}
}
}

// One shared colour lookup; textures stay in flash, framebuffer stays in PSRAM.
namespace KoraIris {
enum Colour { ORIGINAL, BLUE, GREEN, GREY, HAZEL, RED, PURPLE };
static Colour selected=ORIGINAL;
static const char* names[]={"ORIGINAL","BLUE","GREEN","GREY","HAZEL","RED","PURPLE"};
static uint16_t shades[256];
static uint16_t rgb(int r,int g,int b){return ((r>>3)<<11)|((g>>2)<<5)|(b>>3);}
static void select(Colour c){
  selected=c;
  static const int palette[7][3]={{128,128,128},{70,135,205},{83,148,93},{130,134,140},{153,119,65},{173,66,52},{146,89,183}};
  const int* p=palette[int(c)];int mid=(54*p[0]+183*p[1]+19*p[2])>>8;
  for(int y=0;y<256;y++){
    int channels[3];for(int k=0;k<3;k++)channels[k]=y<=mid?p[k]*y/mid:p[k]+(255-p[k])*(y-mid)/(255-mid);
    shades[y]=rgb(channels[0],channels[1],channels[2]);
  }
}
static uint16_t tint(uint16_t pixel){
  int r=(pixel>>11)&31,g=(pixel>>5)&63,b=pixel&31;
  r=(r<<3)|(r>>2);g=(g<<2)|(g>>4);b=(b<<3)|(b>>2);
  int y=(54*r+183*g+19*b)>>8;
  int lo=r<g?r:g;lo=lo<b?lo:b;
  int hi=r>g?r:g;hi=hi>b?hi:b;
  // Keep the bright, nearly neutral photographic corneal reflections intact.
  if(lo>=180 || (hi-lo<22 && y>=145))return pixel;
  return shades[y];
}
}
