// ============================================================
// Utility
// ============================================================
static float clampF(float v, float lo, float hi) {
  if (v < lo) return lo;
  if (v > hi) return hi;
  return v;
}

static int clampI(int v, int lo, int hi) {
  if (v < lo) return lo;
  if (v > hi) return hi;
  return v;
}

static String trimCopy(String s) {
  s.trim();
  return s;
}

static String lowerCopy(String s) {
  s.trim();
  s.toLowerCase();
  return s;
}

static uint16_t rgb565(uint8_t r, uint8_t g, uint8_t b) {
  return ((r & 0xF8) << 8) | ((g & 0xFC) << 3) | (b >> 3);
}

static uint16_t dimColor(uint16_t c, float f) {
  uint8_t r = (uint8_t)(((c >> 11) & 0x1F) * f);
  uint8_t g = (uint8_t)(((c >> 5) & 0x3F) * f);
  uint8_t b = (uint8_t)((c & 0x1F) * f);
  return ((r & 0x1F) << 11) | ((g & 0x3F) << 5) | (b & 0x1F);
}

static uint16_t mixWhite(uint16_t c, float f) {
  uint8_t r = (uint8_t)((c >> 11) & 0x1F);
  uint8_t g = (uint8_t)((c >> 5) & 0x3F);
  uint8_t b = (uint8_t)(c & 0x1F);
  r = (uint8_t)(r + (31 - r) * f);
  g = (uint8_t)(g + (63 - g) * f);
  b = (uint8_t)(b + (31 - b) * f);
  return (r << 11) | (g << 5) | b;
}

static uint16_t driftColor(uint16_t c, uint32_t now) {
  float t = (float)now * 0.00008f;
  float fr = 1.0f + 0.10f * sinf(t);
  float fg = 1.0f + 0.10f * sinf(t + 2.1f);
  float fb = 1.0f + 0.10f * sinf(t + 4.2f);
  uint8_t r = (uint8_t)clampI((int)(((c >> 11) & 0x1F) * fr), 0, 31);
  uint8_t g = (uint8_t)clampI((int)(((c >> 5) & 0x3F) * fg), 0, 63);
  uint8_t b = (uint8_t)clampI((int)((c & 0x1F) * fb), 0, 31);
  return (r << 11) | (g << 5) | b;
}

static uint8_t hash2i(int x, int y) {
  uint32_t h = (uint32_t)x * 7349u ^ (uint32_t)y * 911u;
  h ^= h >> 8;
  return (uint8_t)(h & 255);
}

static uint16_t blend565(uint16_t a, uint16_t b, float t) {
  t = clampF(t, 0.0f, 1.0f);
  float ar = (float)((a >> 11) & 0x1F);
  float ag = (float)((a >> 5) & 0x3F);
  float ab = (float)(a & 0x1F);
  float br = (float)((b >> 11) & 0x1F);
  float bg = (float)((b >> 5) & 0x3F);
  float bb = (float)(b & 0x1F);
  uint8_t r = (uint8_t)lroundf(ar + (br - ar) * t);
  uint8_t g = (uint8_t)lroundf(ag + (bg - ag) * t);
  uint8_t bl = (uint8_t)lroundf(ab + (bb - ab) * t);
  return (uint16_t)((r << 11) | (g << 5) | bl);
}

static uint16_t scale565(uint16_t c, float f) {
  f = clampF(f, 0.0f, 1.8f);
  uint8_t r = (uint8_t)clampI((int)lroundf(((c >> 11) & 0x1F) * f), 0, 31);
  uint8_t g = (uint8_t)clampI((int)lroundf(((c >> 5) & 0x3F) * f), 0, 63);
  uint8_t b = (uint8_t)clampI((int)lroundf((c & 0x1F) * f), 0, 31);
  return (uint16_t)((r << 11) | (g << 5) | b);
}

static uint32_t texHash(int x, int y, uint32_t seed) {
  uint32_t h = (uint32_t)(x + 131) * 374761393u;
  h ^= (uint32_t)(y + 197) * 668265263u;
  h ^= seed * 2246822519u;
  h = (h ^ (h >> 13)) * 1274126177u;
  return h ^ (h >> 16);
}


static void updateMicroSaccades(uint32_t now) {
  if (quietMode || crtState) {
    microX *= 0.80f;
    microY *= 0.80f;
    return;
  }
  if (now >= nextMicroMs) {
    microX = (float)random(-40, 41) / 1000.0f;
    microY = (float)random(-25, 26) / 1000.0f;
    microEndMs = now + (uint32_t)random(45, 110);
    nextMicroMs = now + (uint32_t)random(650, 2600);
  } else if (microEndMs && now > microEndMs) {
    microX *= 0.68f;
    microY *= 0.68f;
    if (fabsf(microX) < 0.001f) microX = 0.0f;
    if (fabsf(microY) < 0.001f) microY = 0.0f;
  }
}

static void setEarLogicalTargets(float leftOffset, float rightOffset) {
  earLTarget = clampF(leftOffset, -35.0f, 35.0f);
  earRTarget = clampF(rightOffset, -35.0f, 35.0f);
}

static int logicalEarToAngle(float logical, bool reversed, int center, int lo, int hi) {
  float d = reversed ? -logical : logical;
  return clampI((int)lroundf((float)center + d), lo, hi);
}

static void triggerEarPerk() {
  if (quietMode) return;
  earPerkMs = millis();
}

static void updateEars() {
  uint32_t now = millis();
  if (now - lastEarMs < 12) return;
  lastEarMs = now;

  float baseL = earLTarget;
  float baseR = earRTarget;

  if (!quietMode) {
    float swayAmp = talkMode ? 5.5f : 7.5f;
    baseL += swayAmp * sinf(now * 0.00055f);
    baseR += swayAmp * sinf(now * 0.00055f + 1.1f);
  }

  if (now < earDanceUntil) {
    float w = 11.0f * sinf(now * 0.018f);
    baseL += w;
    baseR -= w;
  }
  if (now < earDroopUntil) {
    baseL -= 12.0f;
    baseR -= 12.0f;
  }
  if (now < earAlertUntil) {
    baseL += 16.0f;
    baseR += 16.0f;
  }

  if (!quietMode) {
    baseL -= 16.0f * squashL;
    baseR -= 16.0f * squashR;
  }

  if (wakeAnimStart && now - wakeAnimStart < 1800) {
    float p = 1.0f - (float)(now - wakeAnimStart) / 1800.0f;
    baseL += 20.0f * p;
    baseR += 20.0f * p;
  }

  if (earPerkMs) {
    uint32_t age = now - earPerkMs;
    if (age >= EAR_PERK_MS) {
      earPerkMs = 0;
    } else {
      float p = (float)age / (float)EAR_PERK_MS;
      float env = sinf(p * PI);
      baseL += 14.0f * env;
      baseR += 14.0f * env;
    }
  }

  // Main loop publishes targets; the independent task handles all interpolation.
  portENTER_CRITICAL(&mouthMux);
  earCommandL=clampF(baseL*1.35f,-35,35);earCommandR=clampF(baseR*1.35f,-35,35);
  earLNow=earOutputL;earRNow=earOutputR;
  portEXIT_CRITICAL(&mouthMux);
}

