static void renderEye(GFXcanvas16 &cv,float open,float tilt,float curve,
                      float lookX,float lookY,float pupil,uint16_t col,bool leftEye,float breath) {
  if(!eyeSurface||!cv.getBuffer())return;
  Kora3D::render(cv.getBuffer(),eyeSurface,nullptr,
                 open,tilt,curve,lookX,lookY,pupil,col,leftEye,breath);
}

// ============================================================
// CRT mask: OLD ROUND TV POWER-ON
// ============================================================
static void applyCrtMask(GFXcanvas16 &cv, uint16_t col) {
  if (!ENABLE_CRT_FX || !crtState) return;
  uint32_t now = millis();
  float p;
  float hw, hh;
  const int cx = EYEW / 2;
  const int cy = EYEH / 2;

  if (crtState == 1) {
    p = clampF((float)(now - crtStartMs) / (float)CRT_ON_MS, 0.0f, 1.0f);
    float s1 = p / 0.25f;
    float s2 = (p - 0.25f) / 0.30f;
    float s3 = (p - 0.55f) / 0.45f;
    if (p < 0.25f)      { hh = 2.0f;        hw = 3.0f + s1 * 10.0f; }
    else if (p < 0.55f) { hh = 3.0f;        hw = 13.0f + s2 * ((float)cx - 13.0f); }
    else                { hw = (float)cx;   hh = 3.0f + s3 * ((float)cy - 3.0f); }
  } else {
    p = clampF((float)(now - crtStartMs) / (float)CRT_OFF_MS, 0.0f, 1.0f);
    float s1 = p / 0.40f;
    float s2 = (p - 0.40f) / 0.30f;
    float s3 = (p - 0.70f) / 0.30f;
    if (p < 0.40f)      { hw = (float)cx;  hh = (float)cy - s1 * ((float)cy - 3.0f); }
    else if (p < 0.70f) { hh = 3.0f;       hw = (float)cx - s2 * ((float)cx - 13.0f); }
    else                { hh = 2.0f;       hw = 13.0f * (1.0f - s3); }
  }

  int hwi = (int)lroundf(hw);
  int hhi = (int)lroundf(hh);
  if (hwi < 0) hwi = 0;
  if (hhi < 0) hhi = 0;

  cv.fillRect(0, 0, cx - hwi, EYEH, EYE_BLACK);
  cv.fillRect(cx + hwi, 0, EYEW - (cx + hwi), EYEH, EYE_BLACK);
  cv.fillRect(cx - hwi, 0, hwi * 2, cy - hhi, EYE_BLACK);
  cv.fillRect(cx - hwi, cy + hhi, hwi * 2, EYEH - (cy + hhi), EYE_BLACK);

  uint16_t edge = mixWhite(col, 0.90f);
  if (hhi <= 6 && hwi > 2) {
    cv.fillRect(cx - hwi, cy - hhi, hwi * 2, 1, edge);
    cv.fillRect(cx - hwi, cy + hhi - 1, hwi * 2, 1, edge);
  }
  if (hwi <= 6 && hhi > 2) {
    cv.fillRect(cx - hwi, cy - hhi, 1, hhi * 2, edge);
    cv.fillRect(cx + hwi - 1, cy - hhi, 1, hhi * 2, edge);
  }
}

static void drawCrushX(GFXcanvas16 &cv) {
  const int cx = EYEW / 2;
  const int cy = EYEH / 2;
  const float vScale = (float)EYEH / 240.0f;
  int r = (int)(44.0f * vScale);
  cv.drawLine(cx - r + 2, cy - r, cx + r + 2, cy + r, rgb565(20, 20, 30));
  cv.drawLine(cx - r + 2, cy + r, cx + r + 2, cy - r, rgb565(20, 20, 30));
  cv.drawLine(cx - r, cy - r, cx + r, cy + r, EYE_WHITE);
  cv.drawLine(cx - r, cy + r, cx + r, cy - r, EYE_WHITE);
  cv.drawLine(cx - r + 1, cy - r + 1, cx + r - 1, cy + r - 1, EYE_WHITE);
  cv.drawLine(cx - r + 1, cy + r - 1, cx + r - 1, cy - r + 1, EYE_WHITE);
}

static KoraPower::State displayPower;
static bool panelsSleeping=false;
static bool panelWakePending=false;
static uint32_t panelWakeAt=0;
static bool updateDisplayPower(uint32_t now) {
 displayPower.tick(now);
 displayPower.request(quietMode,now);
 if(!quietMode && panelsSleeping){
  tftL.sendCommand(GC9A01A_SLPOUT);tftR.sendCommand(GC9A01A_SLPOUT);
  panelsSleeping=false;panelWakePending=true;panelWakeAt=now;
 }
 if(panelWakePending){
  if(now-panelWakeAt<150)return false;
  tftL.fillScreen(0);tftR.fillScreen(0);
  tftL.sendCommand(GC9A01A_DISPON);tftR.sendCommand(GC9A01A_DISPON);
  panelWakePending=false;
 }
 if(displayPower.phase==KoraPower::Off){
  if(!panelsSleeping){
   tftL.fillScreen(0);tftR.fillScreen(0);
   tftL.sendCommand(GC9A01A_DISPOFF);tftR.sendCommand(GC9A01A_DISPOFF);
   tftL.sendCommand(GC9A01A_SLPIN);tftR.sendCommand(GC9A01A_SLPIN);
   panelsSleeping=true;
  }
  return false;
 }
 return true;
}

struct FrozenEye {
 bool valid=false;float open=0,tilt=0,curve=0,x=0,y=0,pupil=0,breath=0;uint16_t color=0;
};
static FrozenEye frozenEyes[2];
static void renderFrameEye(GFXcanvas16& cv,float open,float tilt,float curve,
 float x,float y,float pupil,uint16_t color,bool left,float breath){
 FrozenEye& f=frozenEyes[left?0:1];
 if(!displayPower.sleeping||!f.valid){f.valid=true;f.open=open;f.tilt=tilt;f.curve=curve;f.x=x;f.y=y;f.pupil=pupil;f.color=color;f.breath=breath;}
 renderEye(cv,f.open,f.tilt,f.curve,f.x,f.y,f.pupil,f.color,left,f.breath);
 KoraCRT::apply(cv.getBuffer(),displayPower);
}

static void drawFace() {
  uint32_t now = millis();
  if(!updateDisplayPower(now))return;
  if (now - lastFrameMs < 50u) return;
  lastFrameMs = now;

  if (!eyeCanvas || !eyeCanvas->getBuffer() || !eyeSurface) return;

  if (crtState == 2 && now - crtStartMs > CRT_OFF_MS) {
    crtState = 0;
    faceNow.openL = faceNow.openR = 0.03f;
  }
  if (crtState == 1 && now - crtStartMs > CRT_ON_MS) {
    crtState = 0;
  }

  finishBlinkIfNeeded();
  updateMicroSaccades(now);
  float envL = (crtState == 2) ? 1.0f : blinkEnvelopeEye(true);
  float envR = (crtState == 2) ? 1.0f : blinkEnvelopeEye(false);
  float oL = (crtState == 2) ? crtFreezeOpenL : clampF(faceNow.openL * envL, 0.0f, 1.05f);
  float oR = (crtState == 2) ? crtFreezeOpenR : clampF(faceNow.openR * envR, 0.0f, 1.05f);

  float sqL = (quietMode || crtState == 2) ? 0.0f : squashL;
  float sqR = (quietMode || crtState == 2) ? 0.0f : squashR;

  oL *= (1.0f - 0.80f * sqL);
  oR *= (1.0f - 0.80f * sqR);

  oL *= displayPower.lid; oR *= displayPower.lid;
  float tiltLx = faceNow.tiltL + sqL * 0.90f;
  float tiltRx = faceNow.tiltR + sqR * 0.90f;
  float curveLx = faceNow.curveL - sqL * 0.35f;
  float curveRx = faceNow.curveR - sqR * 0.35f;
  float lookYx = faceNow.lookY + (sqL + sqR) * 0.28f;
  float pupilBreath = 0.18f*sinf(now*0.0010f)+0.06f*sinf(now*0.00037f);
  float pupilL = clampF(faceNow.pupil + pupilBreath - sqL * 0.30f, 0.05f, 1.0f);
  float pupilR = clampF(faceNow.pupil + pupilBreath * 0.92f - sqR * 0.30f, 0.05f, 1.0f);
  KoraPupil::control.animated(pupilL,pupilR);
  if(KoraPupil::control.mode!=KoraPupil::ANIMATED)pupilL=pupilR=KoraPupil::control.value;
  uint16_t colL = mixWhite(faceNow.color, sqL * 0.70f);
  uint16_t colR = mixWhite(faceNow.color, sqR * 0.70f);


  float breath = 0.0f;
  if (quietMode) {
    breath = 0;
  }

  // V8.2: render LEFT into shared canvas -> push left display
  //       render RIGHT into same canvas -> push right display
  //       / jeden kanwas: L -> lewy ekran, R -> prawy ekran
  renderFrameEye(*eyeCanvas, oL, tiltLx, curveLx,
            clampF(faceNow.lookX + microX, -1.0f, 1.0f),
            clampF(lookYx + microY, -1.0f, 1.0f), pupilL, colL, true, breath);

  applyCrtMask(*eyeCanvas, colL);
  KoraPower::dim(eyeCanvas->getBuffer(),EYEW*EYEH,displayPower.light);
  tftL.drawRGBBitmap(0, 0, eyeCanvas->getBuffer(), EYEW, EYEH);

  renderFrameEye(*eyeCanvas, oR, tiltRx, curveRx,
            clampF(faceNow.lookX + microX * 0.96f, -1.0f, 1.0f),
            clampF(lookYx + microY * 1.04f, -1.0f, 1.0f), pupilR, colR, false, breath);

  applyCrtMask(*eyeCanvas, colR);
  KoraPower::dim(eyeCanvas->getBuffer(),EYEW*EYEH,displayPower.light);
  tftR.drawRGBBitmap(0, 0, eyeCanvas->getBuffer(), EYEW, EYEH);
  renderDurationMs=millis()-now;
  static uint32_t measuredAt=0,frames=0;
  ++frames;
  if(millis()-measuredAt>=2000) {
    eyePairFPS=frames*1000.f/(millis()-measuredAt);frames=0;measuredAt=millis();
  }
}

// ============================================================
// Control helpers
// ============================================================
static void wakeFromPi(uint32_t ms = DEFAULT_IDLE_SLEEP_MS, const String &moodName = "idle_watch") {
  wakeTimeoutMs = ms ? ms : DEFAULT_IDLE_SLEEP_MS; // WAKE / HTTP ms=0 uses the default.
  quietMode = false;
  talkMode = false;
  thinkMode = false;
  autoSlept = false;
  lastInteractionMs = millis();
  applyMood(moodName.length() ? moodName : "idle_watch");

  if(ENABLE_CRT_FX)faceNow=faceTarget;
  crtState = ENABLE_CRT_FX ? 1 : 0;
  crtStartMs = millis();
  wakeAnimStart = millis();

  scheduleNextBlink();
  scheduleNextSoul();
  triggerEarPerk();
}

static void enterPiSleep(bool forcePose = true) {
  (void)forcePose;
  if (ENABLE_CRT_FX && !quietMode && !crtState) {
    crtState = 2;
    crtStartMs = millis();
    crtFreezeOpenL = faceNow.openL;
    crtFreezeOpenR = faceNow.openR;
  }
  quietMode = true;
  talkMode = false;
  thinkMode = false;
  blinkActive = false;
  earPerkMs = 0;
  wakeTimeoutMs = DEFAULT_IDLE_SLEEP_MS; // Also arm direct MOOD/API wake paths.
  wakeAnimStart = 0;
  currentMood = "full_sleep";
  applyMood("full_sleep");
}

static void setQuietMode(bool on, bool forcePose = true) {
  if (on) enterPiSleep(forcePose);
  else wakeFromPi(0, "idle_watch");
}

static void setTalkMode(bool on,const String& moodName) {
  bool wasOn=talkMode;
  if(quietMode&&on)wakeFromPi(0,"idle_watch");
  talkMode=on;lastInteractionMs=millis();lastTalkSignalMs=millis();
  if(on) {
    thinkMode=false;
    talkMoodName=moodName.length()?moodName:"talking_soft";
    if(!applyMood(talkMoodName))applyMood("talking_soft");
    nextTalkMs=0;
  } else if(!quietMode)applyMood("idle_watch");
  portENTER_CRITICAL(&mouthMux);
  mouthInput.talk=on&&!quietMode;mouthInput.manual=false;
  if(!on||!wasOn){mouthInput.external=false;mouthInput.level=0;}
  portEXIT_CRITICAL(&mouthMux);
}

static void setThinkMode(bool on) {
  if (quietMode && on) return;
  thinkMode = on;
  lastInteractionMs = millis();
  if (on) {
    talkMode = false;
    applyMood("thinking");
    nextThinkMs = 0;
  } else {
    applyMood("idle_watch");
  }
}

static void handlePersonFound() {
  personDetected = true;
  if (quietMode) {
    wakeFromPi(DEFAULT_IDLE_SLEEP_MS, "human_found");
  } else {
    lastInteractionMs = millis();
    applyMood("human_found");
  }
}

static void handlePersonLost() {
  personDetected = false;
  lastInteractionMs = millis();
  if (!quietMode) applyMood("idle_watch");
}

// ============================================================
// EYESCFG runtime tuning
// ============================================================
static void saveCfg() {
  prefs.begin("koraeyes", false);
  prefs.putULong("bmin", blinkMinMs);
  prefs.putULong("bmax", blinkMaxMs);
  prefs.putULong("fsrlo", fsrLo);
  prefs.putULong("fsrhi", fsrHi);
  prefs.end();
}

static void loadCfg() {
  prefs.begin("koraeyes", true);
  blinkMinMs = prefs.getULong("bmin", 1800);
  blinkMaxMs = prefs.getULong("bmax", 5200);
  fsrLo = prefs.getULong("fsrlo", 120);
  fsrHi = prefs.getULong("fsrhi", 1600);
  prefs.end();
  if (blinkMaxMs < blinkMinMs) blinkMaxMs = blinkMinMs;
  if (fsrHi <= fsrLo + 50) fsrHi = fsrLo + 500;
}

static void handleEyesCfg(const String &args) {
  int start = 0;
  bool changed = false;
  while (start < args.length()) {
    int sp = args.indexOf(' ', start);
    if (sp < 0) sp = args.length();
    String pair = args.substring(start, sp);
    start = sp + 1;
    int eq = pair.indexOf('=');
    if (eq <= 0) continue;
    String key = lowerCopy(pair.substring(0, eq));
    long val = pair.substring(eq + 1).toInt();
    if (key == "blinkmin" && val >= 300 && val <= 30000) { blinkMinMs = (uint32_t)val; changed = true; }
    else if (key == "blinkmax" && val >= 300 && val <= 60000) { blinkMaxMs = (uint32_t)val; changed = true; }
    else if (key == "fsrlo" && val >= 30 && val <= 4000) { fsrLo = (uint32_t)val; changed = true; }
    else if (key == "fsrhi" && val >= 150 && val <= 4095) { fsrHi = (uint32_t)val; changed = true; }
  }
  if (blinkMaxMs < blinkMinMs) blinkMaxMs = blinkMinMs;
  if (fsrHi <= fsrLo + 50) fsrHi = fsrLo + 500;
  if (changed) saveCfg();
  Serial.println("OK EYESCFG blinkmin=" + String(blinkMinMs) +
                 " blinkmax=" + String(blinkMaxMs) +
                 " fsrlo=" + String(fsrLo) +
                 " fsrhi=" + String(fsrHi) + (changed ? " saved" : ""));
}

