// Photographic lids/lashes, anatomical contours and a spherical iris projection.
// Source assets are embedded above. The same renderer generates the preview.
namespace KoraPower {
enum Phase {Awake,Collapse,Line,Dot,Off,WakeWait,FadeIn,Opening};
struct State {
 Phase phase=Off;bool sleeping=true;uint32_t at=0;
 float light=0,lid=0,sx=0,sy=0,fromLight=0,fromLid=0,fromX=0,fromY=0;
 static float smooth(float t){t=t<0?0:(t>1?1:t);return t*t*(3-2*t);}
 void begin(Phase p,uint32_t now){phase=p;at=now;fromLight=light;fromLid=lid;fromX=sx;fromY=sy;}
 void request(bool sleep,uint32_t now){if(sleep==sleeping)return;sleeping=sleep;begin(sleep?Collapse:WakeWait,now);}
 void tick(uint32_t now){
  for(int n=0;n<8;n++){
   uint32_t elapsed=now-at,duration=0;Phase next=phase;
   switch(phase){
    case Collapse:duration=500;sy=fromY+(.012f-fromY)*smooth(elapsed/500.f);next=Line;break;
    case Line:duration=300;sx=fromX+(.012f-fromX)*smooth(elapsed/300.f);next=Dot;break;
    case Dot:duration=450;light=fromLight*(1-smooth(elapsed/450.f));next=Off;break;
    case WakeWait:duration=150;next=FadeIn;break;
    case FadeIn:{duration=700;float t=smooth(elapsed/700.f);light=fromLight+(1-fromLight)*t;sx=fromX+(1-fromX)*t;sy=fromY+(1-fromY)*t;next=Opening;break;}
    case Opening:duration=350;lid=fromLid+(1-fromLid)*smooth(elapsed/350.f);next=Awake;break;
    case Off:light=lid=sx=sy=0;return;
    case Awake:light=lid=sx=sy=1;return;
   }
   if(elapsed<duration)return;begin(next,at+duration);
  }
 }
};
static void dim(uint16_t* pixels,int count,float light){
 if(light>=.9999f)return;unsigned k=unsigned(light*256.f);if(k>256)k=256;
 for(int i=0;i<count;i++){unsigned c=pixels[i];pixels[i]=((((c>>11)*k)>>8)<<11)|(((((c>>5)&63)*k)>>8)<<5)|(((c&31)*k)>>8);}
}
}

// One shared colour lookup; textures stay in flash, framebuffer stays in PSRAM.
namespace KoraIris {
enum Colour { ORIGINAL, BLUE, GREEN, GREY, HAZEL, RED, PURPLE };
static Colour selected=ORIGINAL;
static const char* names[]={"ORIGINAL","BLUE","GREEN","GREY","HAZEL","RED","PURPLE"};
static uint16_t shades[256];
static uint16_t rgb(int r,int g,int b){return ((r>>3)<<11)|((g>>2)<<5)|(b>>3);}
static void select(Colour c){
  selected=c;
  static const int palette[7][3]={{128,128,128},{70,135,205},{83,148,93},{130,134,140},{153,119,65},{173,66,52},{146,89,183}};
  const int* p=palette[int(c)];int mid=(54*p[0]+183*p[1]+19*p[2])>>8;
  for(int y=0;y<256;y++){
    int channels[3];for(int k=0;k<3;k++)channels[k]=y<=mid?p[k]*y/mid:p[k]+(255-p[k])*(y-mid)/(255-mid);
    shades[y]=rgb(channels[0],channels[1],channels[2]);
  }
}
static uint16_t tint(uint16_t pixel){
  int r=(pixel>>11)&31,g=(pixel>>5)&63,b=pixel&31;
  r=(r<<3)|(r>>2);g=(g<<2)|(g>>4);b=(b<<3)|(b>>2);
  int y=(54*r+183*g+19*b)>>8;
  int lo=r<g?r:g;lo=lo<b?lo:b;
  int hi=r>g?r:g;hi=hi>b?hi:b;
  // Keep the bright, nearly neutral photographic corneal reflections intact.
  if(lo>=180 || (hi-lo<22 && y>=145))return pixel;
  return shades[y];
}
}
namespace Kora3D {
static constexpr int SIZE=240;
static constexpr float ZOOM=1.34f;
static constexpr float IRIS_X=(123.5f-124.5f)*ZOOM+119.5f;
static constexpr float IRIS_Y=(106.5f-113.f)*ZOOM+119.5f;
static constexpr float IRIS_RADIUS=33.5f*ZOOM;
static constexpr float GLOBE_RADIUS=100.f*ZOOM;
struct Surface { uint16_t white; };
static float limit(float v,float lo,float hi){return v<lo?lo:(v>hi?hi:v);}
static uint16_t color(int r,int g,int b){return (int(limit(r,0,255))>>3)<<11|(int(limit(g,0,255))>>2)<<5|(int(limit(b,0,255))>>3);}
static uint16_t blend(uint16_t a,uint16_t b,int w) {
  w=w<0?0:(w>256?256:w);
  // Five fractional bits fit the gap between R and B in this packed layout.
  // Using eight here would leak the red fractional bits into the blue channel.
  w=(w+4)>>3;
  uint32_t rb=((a&0xf81f)*(32-w)+(b&0xf81f)*w)>>5;
  uint32_t g=((a&0x07e0)*(32-w)+(b&0x07e0)*w)>>5;
  return (rb&0xf81f)|(g&0x07e0);
}
static uint16_t mix(uint16_t a,uint16_t b,float w){return blend(a,b,int(limit(w,0,1)*256));}
static uint16_t dim(uint16_t a,float w){return blend(0,a,int(limit(w,0,1)*256));}
static uint16_t sampleY(const uint16_t* tex,int x,float y) {
  y=limit(y,0,238.999f);int iy=int(y);
  return blend(tex[iy*SIZE+x],tex[(iy+1)*SIZE+x],int((y-iy)*256));
}
static uint16_t sample(const uint16_t* tex,float x,float y) {
  x=limit(x,0,238.999f);int ix=int(x);
  return blend(sampleY(tex,ix,y),sampleY(tex,ix+1,y),int((x-ix)*256));
}
struct Landmark {float x,upper,lower,seam;};
static const Landmark landmarks[]={
  {0,111,111,106},{25,111,111,106},{39,112,112,110},
  {55,101,123,116},{73,91,133,120},{94,84,139,122},
  {115,82,141,122},{135,84,140,121},{154,93,137,119},
  {174,108,135,118},{192,123,135,121},{210,131,131,127},
  {222,131,131,129},{239,131,131,129}
};
static void contours(float x,float& up,float& low,float& seam) {
  x=124.5f+(x-119.5f)/ZOOM;
  int i=0;while(i<12&&x>landmarks[i+1].x)i++;
  const Landmark& a=landmarks[i];const Landmark& b=landmarks[i+1];
  float t=limit((x-a.x)/(b.x-a.x),0,1);
  up=a.upper+(b.upper-a.upper)*t;low=a.lower+(b.lower-a.lower)*t;seam=a.seam+(b.seam-a.seam)*t;
  up=(up-113)*ZOOM+119.5f;low=(low-113)*ZOOM+119.5f;seam=(seam-113)*ZOOM+119.5f;
}
static void geometry(Surface* lut) {
  // A complete photographic sclera plate avoids any residual iris silhouette.
  for(int y=0;y<SIZE;y++)for(int x=0;x<SIZE;x++) {
    float up,lo,seam;contours(x,up,lo,seam);
    float yy=lo-up>8?limit(y,up+3,lo-3):float(y);
    lut[y*SIZE+x].white=sampleY(kPhotoSclera,x,yy);
  }
}
struct Column {float uo,lo,seam,up,low,topO,topC,bottomO,bottomC;};
static Column columns[SIZE]; // Scratch: main rendering task only, not the stack.
static void render(uint16_t* dst,const Surface* lut,const uint8_t*,
                   float open,float tilt,float curve,float gazeX,float gazeY,
                   float pupil,uint16_t,bool left,float breath) {
  float a=limit((open-.03f)/.85f,0,1.07f);
  if(a>.97f&&a<1.03f)a=1;
  int photoWeight=int(limit(a,0,1)*256);
  float yaw=limit(left?gazeX:-gazeX,-1,1)*.28f;
  float pitch=limit(gazeY,-1,1)*.14f;
  float cy=cosf(yaw),sy=sinf(yaw),cp=cosf(pitch),sp=sinf(pitch);
  float pr=7.5f+limit(pupil,0,1)*15.5f;
  for(int x=0;x<SIZE;x++) {
    Column& c=columns[x];contours(x,c.uo,c.lo,c.seam);
    float aperture=limit((c.lo-c.uo)/25.f,0,1);
    float slope=(tilt-.12f)*(x-IRIS_X)*.09f*a*aperture;
    c.up=c.seam+(c.uo-c.seam)*a*(1-curve*.10f)+slope+breath;
    c.low=c.seam+(c.lo-c.seam)*a*(1-curve*.32f)+breath;
    if(c.up>c.low)c.up=c.low;
    c.topO=c.uo/(c.up+.001f);c.topC=c.seam/(c.up+.001f);
    c.bottomO=(239-c.lo)/(239-c.low+.001f);c.bottomC=(239-c.seam)/(239-c.low+.001f);
  }
  for(int y=0;y<SIZE;y++)for(int outX=0;outX<SIZE;outX++) {
    int idx=y*SIZE+outX;float rx=outX-119.5f,ry=y-119.5f;
    if(rx*rx+ry*ry>119.7f*119.7f){dst[idx]=0;continue;}
    int x=left?outX:239-outX;
    const Column& c=columns[x];
    if(a==0&&breath==0){dst[idx]=kPhotoClosed[y*SIZE+x];continue;}
    float top=y-c.up,bottom=c.low-y;
    if(top<.5f||bottom<.5f||x<5||x>234||a==0) {
      float yo,yc;
      if(top<0){yo=y*c.topO;yc=y*c.topC;}
      else {yo=c.lo+(y-c.low)*c.bottomO;yc=c.seam+(y-c.low)*c.bottomC;}
      if(photoWeight==256)dst[idx]=sampleY(kPhotoSclera,x,yo);
      else if(photoWeight==0)dst[idx]=sampleY(kPhotoClosed,x,yc);
      else dst[idx]=blend(sampleY(kPhotoClosed,x,yc),sampleY(kPhotoSclera,x,yo),photoWeight);
